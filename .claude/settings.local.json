{
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(npm run build:hooks-rs:*)",
      "mcp__acp__Bash",
      "Bash(pnpm test:*)",
      "Bash(pnpm rebuild:*)",
      "Bash(pnpm vitest:*)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run typecheck:*)",
      "Bash(pnpm run build:*)",
      "Bash(pnpm run test:coverage:*)",
      "Bash(jj status:*)",
      "Bash(jj new:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"%CLAUDE_PROJECT_DIR%\\.claude\\validate-command.exe\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
